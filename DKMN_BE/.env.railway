# Copy these variables to Railway dashboard
# DO NOT commit real credentials to Git

APP_NAME="DKMN Bus Booking"
APP_ENV=production
APP_KEY=base64:t0fi/poBPTu7kbsmZx3isEuF8r4M0l04i7VpUQH51g4=
APP_DEBUG=false
APP_URL=${RAILWAY_PUBLIC_DOMAIN}

# Database - Railway will provide these
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=database

# CORS - Add your frontend URL
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://${RAILWAY_PUBLIC_DOMAIN}

# Mail (configure if needed)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dkmn.com
MAIL_FROM_NAME="DKMN Bus Booking"
